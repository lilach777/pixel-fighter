# Pixel Fighters: Arcade — example configuration. Copy to .env and adjust.
# Safe placeholders only. Never commit real secrets (none are required).

# ---------------- Game server (Node.js) ----------------
# Port the HTTP + WebSocket server listens on (hosting providers usually set PORT for you).
PORT=8787
HOST=0.0.0.0
# Comma-separated list of browser origins allowed to open WebSockets.
# Empty = "*" in development (local/LAN testing) and "self" in production (the page's own
# host, correct when this server also serves the game). For split hosting list your exact
# frontend origin(s), e.g. https://pixel-fighters.example.com. "*" is refused in production.
ALLOWED_ORIGINS=
# Snapshot rate sent to clients (simulation always runs at 60 Hz).
SNAPSHOT_HZ=30
# How long a disconnected player's seat is held during a match before they forfeit.
RECONNECT_GRACE_MS=20000
# Countdown after both players are ready.
COUNTDOWN_MS=3000
# Idle lobbies are removed after this long without activity.
ROOM_IDLE_MS=900000
MAX_ROOMS=500
MAX_CONNECTIONS=2000
# Simultaneous WebSocket connections per client IP.
MAX_CONNECTIONS_PER_IP=16
# Where the per-IP limit gets the client's IP (see docs/DEPLOYMENT.md, "Client IP behind a proxy"):
#   off        TCP peer address; forwarding headers ignored (default; local dev, direct exposure)
#   cloudflare CF-Connecting-IP set by Cloudflare's edge. Render web services: use this.
#              Self-hosted behind Cloudflare: only if the origin accepts traffic from Cloudflare only.
#   xff        X-Forwarded-For read right-to-left, trusting ONLY the proxies in TRUSTED_PROXIES.
# The left-most X-Forwarded-For entry is never trusted (clients can set it).
TRUST_PROXY=off
# Required for TRUST_PROXY=xff: comma-separated IPs/CIDRs your reverse proxy connects from,
# e.g. TRUSTED_PROXIES=127.0.0.1,10.0.0.0/8
TRUSTED_PROXIES=
# Online match rules.
ROUND_SECONDS=60
ROUNDS_TO_WIN=2
# Serve the built frontend (client/dist) from the game server (single-service deploy).
# Defaults to true when NODE_ENV=production and client/dist exists.
SERVE_CLIENT=false
# Built client location (absolute, or relative to the working directory).
# CLIENT_DIST=client/dist

# ---------------- Frontend (Vite, read at BUILD time) ----------------
# Leave empty to use same-origin "/ws" (dev proxy, or the single-service deployment).
# Set when the frontend and game server are hosted separately, e.g.
# VITE_WS_URL=wss://pixel-fighters-server.example.com/ws
VITE_WS_URL=
